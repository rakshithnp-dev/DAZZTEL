# Database
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/hotelyo_dev?schema=public"
TEST_DATABASE_URL="postgresql://postgres@127.0.0.1:5433/hotelyo_test?schema=public"

# Redis & Queues
REDIS_URL="redis://localhost:6379"
REDIS_USE_MOCK=true

# Application Ports
API_PORT=4000
GUEST_WEB_PORT=3000
STAFF_WEB_PORT=3001
ADMIN_WEB_PORT=3002

# Authentication & Security
JWT_ACCESS_SECRET="dev-insecure-access-secret-32-chars-long!!"
JWT_REFRESH_SECRET="dev-insecure-refresh-secret-32-chars-long!"
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
OTP_KEYED_HASH_SECRET="dev-otp-hmac-secret-min-32-bytes-long!!"
AES_256_DOCUMENT_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Payment Gateway (Razorpay/UPI Adapter)
PAYMENT_GATEWAY_PROVIDER="razorpay"
RAZORPAY_KEY_ID="rzp_test_sampleKey123"
RAZORPAY_KEY_SECRET="rzp_test_secretKey456"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_xyz"

# Notifications (Twilio / AWS SES / FCM)
SMS_PROVIDER="mock"
EMAIL_PROVIDER="mock"
FCM_SERVER_KEY="mock-fcm-key"

# Storage (S3 / MinIO / Local)
STORAGE_DRIVER="local"
S3_BUCKET="hotelyo-docs"
S3_REGION="ap-south-1"
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Environment
NODE_ENV="development"
DEFAULT_PROPERTY_TIMEZONE="Asia/Kolkata"
DEFAULT_CURRENCY="INR"
